# Azure OpenAI / Azure AI Foundry
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Set to `true` only if the chat deployment is a reasoning model (o-series or
# the GPT-5 reasoning family). Those reject both `max_tokens` and
# `temperature`; ordinary deployments want exactly those two. Wrong either way
# is a 400, and the upstream error log names the parameter.
AZURE_OPENAI_REASONING_MODEL=
# Last dated GA version. Microsoft now recommends the v1 API instead (set
# this to `v1`), which is what streamed token totals and cached-token
# accounting require - neither exists in the 2024-10-21 schema.
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional. Per-request timeout in ms; defaults to 30000.
AZURE_OPENAI_TIMEOUT_MS=

# Azure AI Search (RAG vector store + semantic cache)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_CACHE_INDEX_NAME=

# Azure AI Content Safety
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_API_KEY=

# Trusted proxies in front of this service that append to x-forwarded-for.
# 1 for App Service / Static Web Apps taking traffic directly; 2 behind Front
# Door. Too high and a caller can spoof their identity to evade rate limits.
TRUSTED_PROXY_HOPS=1

# Origins allowed to call this API (the portfolio site).
# Comma-separated. Unset means no browser origin is allowed.
ALLOWED_ORIGIN=http://localhost:5173
