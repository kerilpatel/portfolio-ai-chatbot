{
  "name": "portfolio-ai-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "prompt:size": "node scripts/prompt-size.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"*.{js,cjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"*.{js,cjs,json,md}\"",
    "test": "node --test \"src/**/*.test.ts\"",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "next": "16.4.5",
    "openai": "^7.53.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "zod": "^4.6.6",
    "source-map-js": "^1.2.2"
  }
}
